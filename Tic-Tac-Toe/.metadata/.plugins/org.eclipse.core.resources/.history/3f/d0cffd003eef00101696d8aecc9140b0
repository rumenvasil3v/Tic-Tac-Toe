package tictac;

import java.awt.event.KeyEvent;
import java.awt.event.KeyListener;

public class KeyHandler implements KeyListener {
	
	public boolean isGameRunning;
	public boolean firstPlayerTurn = true;
	public boolean secondPlayerTurn = false;
	
	public KeyHandler(boolean isGameRunning) {
		this.isGameRunning = isGameRunning;
	}
	
	// the top 3 squares
	public boolean topLeft;
	public boolean topMiddle;
	public boolean topRight;

	// the middle 3 squares
	public boolean middleLeft;
	public boolean middleMiddle;
	public boolean middleRight;

	// the bottom 3 squares
	public boolean bottomLeft;
	public boolean bottomMiddle;
	public boolean bottomRight;
	
	public boolean topLeftS;
	public boolean topMiddleS;
	public boolean topRightS;

	// the middle 3 squares
	public boolean middleLeftS;
	public boolean middleMiddleS;
	public boolean middleRightS;

	// the bottom 3 squares
	public boolean bottomLeftS;
	public boolean bottomMiddleS;
	public boolean bottomRightS;

	@Override
	public void keyTyped(KeyEvent e) {
	}

	@Override
	public void keyPressed(KeyEvent e) {
		
		if (this.firstPlayerTurn) {
			int code = e.getKeyCode();
			
			if (code == KeyEvent.VK_1) {
				this.topLeft = true;
			}

			if (code == KeyEvent.VK_2) {
				this.topMiddle = true;
			}

			if (code == KeyEvent.VK_3) {
				this.topRight = true;
			}

			if (code == KeyEvent.VK_4) {
				this.middleLeft = true;
			}

			if (code == KeyEvent.VK_5) {
				this.middleMiddle = true;
			}

			if (code == KeyEvent.VK_6) {
				this.middleRight = true;
			}

			if (code == KeyEvent.VK_7) {
				this.bottomLeft = true;
			}

			if (code == KeyEvent.VK_8) {
				this.bottomMiddle = true;
			}

			if (code == KeyEvent.VK_9) {
				this.bottomRight = true;
			}
		} else if (this.secondPlayerTurn) {	
			int code = e.getKeyCode();
			
			if (code == KeyEvent.VK_A) {
				this.topLeft = true;
			}
			
			if (code == KeyEvent.VK_B) {
				this.topMiddle = true;
			} 
			
			if (code == KeyEvent.VK_C) {
				this.topRight = true;
			}
			
			if (code == KeyEvent.VK_D) {
				this.middleLeft = true;
			}
			
			if (code == KeyEvent.VK_E) {
				this.middleMiddle = true;
			}
			
			if (code == KeyEvent.VK_F) {
				this.middleRight = true;
			}
			
			if (code == KeyEvent.VK_G) {
				this.bottomLeft = true;
			}
			
			if (code == KeyEvent.VK_H) {
				this.bottomMiddle = true;
			}
			
			if (code == KeyEvent.VK_I) {
				this.bottomRight = true;
			}
		}
	}

	@Override
	public void keyReleased(KeyEvent e) {

		int code = e.getKeyCode();

		if (code == KeyEvent.VK_1) {
			this.topLeft = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_2) {
			this.topMiddle = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_3) {
			this.topRight = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_4) {
			this.middleLeft = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_5) {
			this.middleMiddle = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_6) {
			this.middleRight = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_7) {
			this.bottomLeft = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_8) {
			this.bottomMiddle = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}

		if (code == KeyEvent.VK_9) {
			this.bottomRight = false;
			
			this.firstPlayerTurn = false;
			this.secondPlayerTurn = true;
		}
		
		if (code == KeyEvent.VK_A) {
			this.topLeft = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		} 
		
		if (code == KeyEvent.VK_B) {
			this.topMiddle = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		} 
		
		if (code == KeyEvent.VK_C) {
			this.topRight = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
		
		if (code == KeyEvent.VK_D) {
			this.middleLeft = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
		
		if (code == KeyEvent.VK_E) {
			this.middleMiddle = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
		
		if (code == KeyEvent.VK_F) {
			this.middleRight = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
		
		if (code == KeyEvent.VK_G) {
			this.bottomLeft = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
		
		if (code == KeyEvent.VK_H) {
			this.bottomMiddle = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
		
		if (code == KeyEvent.VK_I) {
			this.bottomRight = false;
			
			this.firstPlayerTurn = true;
			this.secondPlayerTurn = false;
		}
	}
}
