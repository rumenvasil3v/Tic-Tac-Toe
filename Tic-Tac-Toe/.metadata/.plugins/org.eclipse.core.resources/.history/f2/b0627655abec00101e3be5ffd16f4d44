package tictac;

import java.awt.event.KeyEvent;
import java.awt.event.KeyListener;

public class KeyHandler implements KeyListener {

	// the top 3 squares
	public boolean topLeft;
	public boolean topMiddle;
	public boolean topRight;

	// the middle 3 squares
	public boolean middleLeft;
	public boolean middleMiddle;
	public boolean middleRight;

	// the bottom 3 squares
	public boolean bottomLeft;
	public boolean bottomMiddle;
	public boolean bottomRight;

	@Override
	public void keyTyped(KeyEvent e) {
	}

	@Override
	public void keyPressed(KeyEvent e) {

		int code = e.getKeyCode();

		if (code == KeyEvent.VK_1) {
			this.topLeft = true;
			this.topMiddle = false;
			this.topRight = false;

			this.middleLeft = false;
			this.middleMiddle = false;
			this.middleRight = false;

			this.bottomLeft = false;
			this.bottomMiddle = false;
			this.bottomRight = false;
		}

		if (code == KeyEvent.VK_2) {
			this.topLeft = false;
			this.topMiddle = true;
			this.topRight = false;

			this.middleLeft = false;
			this.middleMiddle = false;
			this.middleRight = false;

			this.bottomLeft = false;
			this.bottomMiddle = false;
			this.bottomRight = false;
		}

		if (code == KeyEvent.VK_3) {
			this.topLeft = false;
			this.topMiddle = false;
			this.topRight = true;
			
			this.middleLeft = false;
			this.middleMiddle = false;
			this.middleRight = false;

			this.bottomLeft = false;
			this.bottomMiddle = false;
			this.bottomRight = false;
		}

		if (code == KeyEvent.VK_4) {
			this.topLeft = false;
			this.topMiddle = false;
			this.topRight = false;
			
			this.middleLeft = true;
			this.middleMiddle = false;
			this.middleRight = false;

			this.bottomLeft = false;
			this.bottomMiddle = false;
			this.bottomRight = false;
		}

		if (code == KeyEvent.VK_5) {
			this.topLeft = false;
			this.topMiddle = false;
			this.topRight = false;
			
			this.middleLeft = false;
			this.middleMiddle = true;
			this.middleRight = false;

			this.bottomLeft = false;
			this.bottomMiddle = false;
			this.bottomRight = false;
		}

		if (code == KeyEvent.VK_6) {
			this.topLeft = false;
			this.topMiddle = false;
			this.topRight = false;
			
			this.middleLeft = false;
			this.middleMiddle = false;
			this.middleRight = true;

			this.bottomLeft = false;
			this.bottomMiddle = false;
			this.bottomRight = false;
		}

		if (code == KeyEvent.VK_7) {
			this.bottomLeft = true;
		}

		if (code == KeyEvent.VK_8) {
			this.bottomMiddle = true;
		}

		if (code == KeyEvent.VK_9) {
			this.bottomRight = true;
		}
	}

	@Override
	public void keyReleased(KeyEvent e) {

		int code = e.getKeyCode();

		if (code == KeyEvent.VK_1) {
			this.topLeft = false;
		}

		if (code == KeyEvent.VK_2) {
			this.topMiddle = false;
		}

		if (code == KeyEvent.VK_3) {
			this.topRight = false;
		}

		if (code == KeyEvent.VK_4) {
			this.middleLeft = false;
		}

		if (code == KeyEvent.VK_5) {
			this.middleMiddle = false;
		}

		if (code == KeyEvent.VK_6) {
			this.middleRight = false;
		}

		if (code == KeyEvent.VK_7) {
			this.bottomLeft = false;
		}

		if (code == KeyEvent.VK_8) {
			this.bottomMiddle = false;
		}

		if (code == KeyEvent.VK_9) {
			this.bottomRight = false;
		}
	}
}
